# Production env. Copy to .env.prod (gitignored). NEVER commit real secrets.
# Used with: docker compose -f docker/docker-compose-all.yml -f docker/docker-compose.prod.yml --env-file .env.prod up -d

SPRING_PROFILES_ACTIVE=prod

# ELK — REQUIRED in prod
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=__SET_A_STRONG_PASSWORD__
LOG_ENVIRONMENT=production
ES_XPACK_SECURITY=true